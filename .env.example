# ============================================================
# 運用で変更するのはこのブロックだけ（オペレーター向け）
# 各項目の意味と設定例は README の「9. 参考：環境変数」
# ============================================================

# --- LLM（生成に使うモデル） ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gemma-4-31B
OPENAI_CONCURRENCY=4
WIKI_REQUEST_TIMEOUT=900

# --- doc-parser（文書変換サービス。`.md` / `.txt` のみなら無くても可） ---
WIKI_PARSER_BASE_URL=

# --- GROWI（公開先） ---
GROWI_URL=
GROWI_TOKEN=
GROWI_MODE=attach
GROWI_TIMEOUT=30

# --- 生成ページ ---
WIKI_OUTPUT_LANGUAGE="Japanese (日本語)"
WIKI_LINKER_ENABLED=true

# ============================================================
# ここから下は開発者向けフラグ（通常変更しません）
# 意味・影響範囲を確認できるまで変更しないこと（開発者向け説明は DEV_README.md）
# ============================================================

WRITER_BASE_URL=
WRITER_MODEL_NAME=gemma-4-31B
WIKI_EMBED_BACKEND=server
WIKI_EMBED_BASE_URL=
WIKI_EMBED_MODEL=cl-nagoya/ruri-v3-310m
WIKI_EMBED_DIM=768
WIKI_INGEST_MODE=wiki
WIKI_LINKER_MODE=neo
# Two hops only; the third value is omitted so 3-hop expansion is off (graph/linker/neo.py).
WIKI_LINKER_HOP_CAPS=30,20
# Only knob that costs chat calls: LLM calls/chunk = ceil(this/4) + entity candidates.
WIKI_LINKER_EDGE_CANDIDATES=8
WIKI_LINKER_EDGES_PER_TARGET=3
WIKI_LINKER_SCREEN_CANDIDATES=40
WIKI_LINKER_VERIFY_TOP=10
# Cost-free: how many kept links may become visible.
WIKI_LINKER_CURATE_KEEP=10
WIKI_LINKER_FOOTER_MAX=18
# 0 = no per-candidate LLM second opinion (each one was an extra chat call).
WIKI_LINKER_TIEBREAK_FLOOR=0
# Inline slots: WIKI_LINKER_INLINE_MAX / _INLINE_MAX_BIG / _INLINE_MAX_NEO.
# Shisa DE-2 uses the OpenAI-compatible vLLM endpoint and bounded concurrent requests.
WIKI_JEV_BACKEND=shisa
WIKI_JEV_BASE_URL=
WIKI_JEV_MODEL=jev
WIKI_JEV_TOKENIZER=shisa-ai/shisa-de-2-FP8-dynamic
WIKI_JEV_HTTP_CONCURRENCY=8
# Local JEV endpoints and runtimes are intentionally disabled. The linker falls
# back to its regular LLM path if Shisa is unavailable, never to local JEV.
# WIKI_JEV_BASE_URL=http://10.160.144.101:51023
# WIKI_JEV_BASE_URL=http://10.160.152.38:51023
# WIKI_JEV_BACKEND=gguf
# WIKI_JEV_BACKEND=local
# WIKI_JEV_GGUF_LOCAL_PATH=/home/seigyo/llm-wiki/jev/models/chaoliangUNSW/Jev-Style-0.8B-Decision-v3-GGUF
# WIKI_JEV_GGUF_QUANT=Q4_K_M
# WIKI_JEV_GGUF_MANY_MODE=batched
WIKI_JEV_MAX_BATCH_REQUESTS=128
# WIKI_JEV_SCORE_BIN=/home/seigyo/llm-wiki/jev/models/chaoliangUNSW/Jev-Style-0.8B-Decision-v3-GGUF/build/jev-score
# WIKI_JEV_LOCAL_PATH=chaoliangUNSW/Jev-Style-0.8B-Decision-v3
# WIKI_JEV_DEVICE=cuda
# WIKI_JEV_DTYPE=bfloat16
